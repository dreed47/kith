# Copy to .env (next to compose.yaml) and fill in. Only DB_PASSWORD is required.
DB_PASSWORD=change-me
# PORT=8000

# Behind an HTTPS reverse proxy: send cookies over https only, and trust the proxy's client address.
# KITH_SECURE_COOKIES=1
# KITH_TRUSTED_PROXIES=1
# The site's own address, for links in email.
# KITH_SITE_URL=https://tree.example.org

# Email (account confirmations, password resets, invitations). Off while KITH_SMTP_USER is empty.
# KITH_SMTP_HOST=smtp.example.org
# KITH_SMTP_PORT=587
# KITH_SMTP_USER=
# KITH_SMTP_PASSWORD=
# KITH_MAIL_FROM=
